{
  "mcpServers": {
    "mcp1": {
      "command": "node",
      "args": [
        "./mcp-servers/mcp1/server.js"
      ],
      "env": {
        "MCP_SERVER_NAME": "mcp1",
        "MCP_PORT": "3001"
      },
      "disabled": false,
      "autoStart": true
    },
    "context7": {
      "command": "node",
      "args": [
        "./mcp-servers/context7/client.js"
      ],
      "env": {
        "MCP_SERVER_NAME": "context7",
        "CONTEXT7_URL": "http://localhost:3007",
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "disabled": false,
      "autoStart": true
    }
  },
  "settings": {
    "autoStartServers": true,
    "logLevel": "info",
    "dataDir": "./mcp-data"
  }
}
