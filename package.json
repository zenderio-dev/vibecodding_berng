{
  "name": "vibecodding-mcp-servers",
  "version": "1.0.0",
  "description": "MCP Servers for vibecodding project - mcp1 local server and context7 client",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:all",
    "start:all": "concurrently \"npm run start:mcp1\" \"npm run start:context7\"",
    "start:mcp1": "node mcp-servers/mcp1/server.js",
    "start:context7": "node mcp-servers/context7/client.js",
    "start:mcp1:watch": "nodemon mcp-servers/mcp1/server.js",
    "start:context7:watch": "nodemon mcp-servers/context7/client.js",
    "health:check": "node scripts/health-check.js",
    "test:mcp1": "curl http://localhost:3001/health",
    "test:context7": "curl http://localhost:3002/health"
  },
  "keywords": [
    "mcp",
    "server",
    "agents",
    "context"
  ],
  "author": "vibecodding",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
